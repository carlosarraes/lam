# Copy to ~/.config/lam/android-signing.properties and point it at the existing key.
# LAM_ANDROID_KEYSTORE_PROPERTIES may override that properties path.
# Never generate a replacement key during an upgrade build.
storeFile=/home/you/.config/lam/keys/lam-release.p12
storePassword=replace-with-password-manager-value
keyAlias=lam
keyPassword=replace-with-password-manager-value
